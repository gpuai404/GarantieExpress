<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>GarantieExpress</title>
  <options customize="never" require-scripts="false" hostArchitectures="@@ARCHITECTURE@@" />
  <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true" />

  <volume-check script="true">
    <allowed-os-versions>
      <os-version min="15.0" />
    </allowed-os-versions>
  </volume-check>

  <choices-outline>
    <line choice="default" />
  </choices-outline>
  <choice
    id="default"
    title="GarantieExpress"
    description="Install GarantieExpress in the Applications folder."
    visible="false">
    <pkg-ref id="com.garantieexpress.app.pkg" />
  </choice>

  <pkg-ref id="com.garantieexpress.app.pkg">GarantieExpress-component.pkg</pkg-ref>
  <pkg-ref id="com.garantieexpress.app.pkg">
    <must-close>
      <app id="com.garantieexpress.app" />
    </must-close>
  </pkg-ref>
</installer-gui-script>
