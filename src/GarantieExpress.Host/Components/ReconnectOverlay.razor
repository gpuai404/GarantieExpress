<div id="components-reconnect-modal" class="reconnect-overlay" role="status" aria-live="assertive">
    <div class="reconnect-card">
        <p class="components-reconnect-show">The local application connection was interrupted. Reconnecting…</p>
        <p class="components-reconnect-failed">Reconnection failed.</p>
        <p class="components-reconnect-rejected">The local application stopped. Start GarantieExpress again.</p>
        <button id="components-reconnect-button" class="button secondary" type="button">Retry</button>
    </div>
</div>
