@inject ILocalizationService Localization
@inject ILocalApplicationLifetime ApplicationLifetime

<main class="server-error" aria-labelledby="server-error-title">
    <section class="server-error-card" role="alert">
        <p class="eyebrow">@Localization["Update_ServerError_Eyebrow"]</p>
        <h1 id="server-error-title">@Localization["Update_ServerError_Title"]</h1>
        <p>@Localization["Update_ServerError_Text"]</p>
        <div class="server-error-actions">
            <button type="button"
                    class="button primary"
                    disabled="@Refreshing"
                    @onclick="OnRefresh">
                @(Refreshing
                    ? Localization["Update_Refreshing"]
                    : Localization["Update_Refresh"])
            </button>
            <button type="button"
                    class="button secondary"
                    @onclick="ApplicationLifetime.RequestShutdown">
                @Localization["Application_Quit"]
            </button>
        </div>
    </section>
</main>

@code {
    [Parameter]
    public bool Refreshing { get; set; }

    [Parameter]
    public EventCallback OnRefresh { get; set; }
}
