@inject ILocalizationService Localization

<section class="form-card">
    <div class="section-heading"><span>01</span><div><h2>@Localization["Settings_Shop"]</h2><p>@Localization["Settings_ShopText"]</p></div></div>
    <div class="logo-editor">
        <div class="logo-preview">
            @if (Settings.LogoDataUri is not null) { <img src="@Settings.LogoDataUri" alt="@(Localization["Settings_CurrentLogo"])" /> }
            else { <span>@Localization["Settings_NoLogo"]</span> }
        </div>
        <div>
            <label class="file-label">@Localization["Settings_LogoLabel"]<InputFile OnChange="LogoChanged" accept="image/png,image/jpeg,image/webp" /></label>
            <p class="field-hint">@Localization["Settings_LogoHint"]</p>
            @if (Settings.LogoDataUri is not null) { <button type="button" class="text-button" @onclick="RemoveLogo">@Localization["Settings_RemoveLogo"]</button> }
        </div>
    </div>
    <div class="form-grid">
        <label>@Localization["Settings_Name"]<InputText @bind-Value="Settings.Name" /></label>
        <label>@Localization["Settings_Slogan"]<InputText @bind-Value="Settings.Slogan" /></label>
        <label>@Localization["Settings_Address"]<InputText @bind-Value="Settings.Address" /></label>
        <label>@Localization["Settings_Phone"]<InputText @bind-Value="Settings.Phone" /></label>
        <label>@Localization["Settings_Vat"]<InputText @bind-Value="Settings.Vat" /></label>
        <label>@Localization["Settings_NumberPrefix"]<InputText @bind-Value="Settings.NumberPrefix" /></label>
    </div>
    <label>@Localization["Settings_Services"]<textarea value="@ServicesText" @oninput="ServicesChanged" rows="4"></textarea></label>
</section>

@code {
    [Parameter, EditorRequired] public SettingsFormModel Settings { get; set; } = null!;
    [Parameter] public string ServicesText { get; set; } = string.Empty;
    [Parameter] public EventCallback<InputFileChangeEventArgs> LogoChanged { get; set; }
    [Parameter] public EventCallback RemoveLogo { get; set; }
    [Parameter] public EventCallback<ChangeEventArgs> ServicesChanged { get; set; }
}
